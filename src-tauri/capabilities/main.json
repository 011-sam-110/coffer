{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every Coffer command except the Quick Access ones. Only listen/unlisten of the core; no plugin permissions: Rust opens dialogs and URLs (SPEC 3.7).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-folder-info",
    "allow-folder-pick",
    "allow-vault-status",
    "allow-vault-create",
    "allow-secret-key-rotate",
    "allow-vault-open",
    "allow-vault-unlock",
    "allow-vault-unlock-hello",
    "allow-vault-lock",
    "allow-vault-change-password",
    "allow-vault-move",
    "allow-vault-save-again",
    "allow-vault-open-older",
    "allow-hello-set",
    "allow-secret-key-validate",
    "allow-emergency-kit",
    "allow-kdf-benchmark",
    "allow-items-list",
    "allow-item-get",
    "allow-item-reveal",
    "allow-item-copy",
    "allow-item-save",
    "allow-item-patch",
    "allow-item-set-state",
    "allow-items-bulk",
    "allow-item-delete-forever",
    "allow-trash-empty",
    "allow-item-revisions",
    "allow-item-restore-revision",
    "allow-item-password-history",
    "allow-item-open-url",
    "allow-totp-code",
    "allow-totp-parse",
    "allow-totp-from-image",
    "allow-ssh-generate",
    "allow-generate",
    "allow-generator-copy",
    "allow-generator-history",
    "allow-generator-history-reveal",
    "allow-generator-history-copy",
    "allow-generator-history-clear",
    "allow-password-strength",
    "allow-health-report",
    "allow-health-check-breaches",
    "allow-import-preview",
    "allow-import-commit",
    "allow-import-undo",
    "allow-import-delete-source",
    "allow-export-vault",
    "allow-backups-list",
    "allow-backup-restore",
    "allow-settings-get",
    "allow-settings-set",
    "allow-edit-state",
    "allow-main-show",
    "allow-app-quit",
    "allow-main-hide"
  ]
}
